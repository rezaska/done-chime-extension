{
  "manifest_version": 3,
  "name": "Done Chime for Claude",
  "short_name": "Done Chime",
  "version": "1.0.8",
  "description": "Plays a chime and shows a notification when Claude finishes a response. Multitask freely without watching the tab.",
  "permissions": ["notifications", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Done Chime for Claude"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
